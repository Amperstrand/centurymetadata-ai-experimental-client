{
  "name": "centurymetadata-ai-experimental-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Interactive learning client for centurymetadata (post-quantum key-value store). TypeScript port of the Python reference implementation.",
  "exports": {
    ".": {
      "types": "./src/lib/cm/index.ts",
      "import": "./src/lib/cm/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:roundtrip": "node test/roundtrip.mjs",
    "test:unit": "node test/unit-tests.mjs",
    "test:e2e": "playwright test",
    "spec:check": "greatspectate check --config specquotes.toml --comment-start '// ' --comment-continue '//' -k src/lib/cm/*.ts",
    "spec:coverage": "greatspectate check --config specquotes.toml --comment-start '// ' --comment-continue '//' --coverage .coverage -k src/lib/cm/*.ts && greatspectate coverage --config specquotes.toml --coverage .coverage --all-sections"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
